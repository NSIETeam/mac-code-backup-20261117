<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.1.7</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">None</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="core/**/*.cs"/>
    <ProjectReference Include="core/Siyue.Printing.csproj"/>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.*"/>
    <Content Include="vendor/NativePrint.exe" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="vendor/native-print.sha256" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="vendor/pdfium.dll" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="vendor/pdfium.sha256" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="vendor/pdfium-licenses/**/*" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="operations/*.ps1" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="vendor/RustDesk.exe" CopyToOutputDirectory="PreserveNewest" Condition="'$(IncludeRemoteDesktop)' == 'true'"/>
    <Content Include="vendor/RustDesk-*.txt" CopyToOutputDirectory="PreserveNewest" Condition="'$(IncludeRemoteDesktop)' == 'true'"/>
    <Content Include="vendor/rustdesk.sha256" CopyToOutputDirectory="PreserveNewest" Condition="'$(IncludeRemoteDesktop)' == 'true'"/>
  </ItemGroup>
</Project>
